{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-brain/official-decision-v2.schema.json",
  "title": "Gold Brain Official Decision 2.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "decision_id", "reasoning_id", "recommendation",
    "trade_quality", "reliability", "explanation", "critique_id", "decided_at"
  ],
  "properties": {
    "contract_version": { "const": "2.0.0" },
    "decision_id": { "type": "string", "minLength": 1 },
    "reasoning_id": { "type": "string", "minLength": 1 },
    "recommendation": {
      "enum": ["BUY_SETUPS_ONLY", "SELL_SETUPS_ONLY", "WAIT", "NO_OPINION"]
    },
    "trade_quality": { "type": "integer", "minimum": 0, "maximum": 100 },
    "reliability": { "type": "integer", "minimum": 0, "maximum": 100 },
    "critique_id": { "type": "string", "minLength": 1 },
    "decided_at": { "type": "string", "format": "date-time" },
    "explanation": { "$ref": "#/$defs/explanation" }
  },
  "$defs": {
    "nonEmptyAnswers": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": [
        "reasoning_reference", "knowledge_reference", "evidence_reference", "fact", "source"
      ],
      "properties": {
        "reasoning_reference": { "type": "string", "minLength": 1 },
        "knowledge_reference": { "type": "string", "minLength": 1 },
        "evidence_reference": { "type": "string", "minLength": 1 },
        "fact": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "explanation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "contract_version", "decision", "why", "why_now", "why_not_opposite",
        "why_not_wait", "supporting_evidence", "weakening_evidence", "missing_information",
        "invalidation_conditions", "traces"
      ],
      "properties": {
        "contract_version": { "const": "1.0.0" },
        "decision": {
          "enum": ["BUY_SETUPS_ONLY", "SELL_SETUPS_ONLY", "WAIT", "NO_OPINION"]
        },
        "why": { "$ref": "#/$defs/nonEmptyAnswers" },
        "why_now": { "$ref": "#/$defs/nonEmptyAnswers" },
        "why_not_opposite": { "$ref": "#/$defs/nonEmptyAnswers" },
        "why_not_wait": { "$ref": "#/$defs/nonEmptyAnswers" },
        "supporting_evidence": { "$ref": "#/$defs/nonEmptyAnswers" },
        "weakening_evidence": { "$ref": "#/$defs/nonEmptyAnswers" },
        "missing_information": { "$ref": "#/$defs/nonEmptyAnswers" },
        "invalidation_conditions": { "$ref": "#/$defs/nonEmptyAnswers" },
        "traces": {
          "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/trace" }
        }
      }
    }
  }
}
