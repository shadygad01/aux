{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-brain/research-proposal-v1.schema.json",
  "title": "Research Proposal 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "proposal_id", "question", "hypothesis", "method",
    "evidence_references", "statistics", "risk", "expected_gain", "confidence",
    "migration_impact", "proposed_at", "status"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "evidence_references": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "statistics": { "type": "object" },
    "risk": { "type": "string", "minLength": 1 },
    "expected_gain": { "type": "string", "minLength": 1 },
    "confidence": { "type": "object" },
    "migration_impact": { "type": "string", "minLength": 1 },
    "proposed_at": { "type": "string", "format": "date-time" },
    "status": { "const": "PROPOSAL" }
  }
}
