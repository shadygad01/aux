{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-brain/reasoning-comprehension-v1.schema.json",
  "title": "Reasoning Comprehension Review 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id", "reasoning_id", "verdict", "plain_language_summary", "explained_concepts",
    "explained_statistics", "opaque_elements", "trader_judgment_required", "automation_limit",
    "reviewer", "evidence_references", "reviewed_at", "policy_version"
  ],
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "reasoning_id": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["APPROVED", "REJECTED"] },
    "plain_language_summary": { "type": "string", "minLength": 1 },
    "explained_concepts": { "type": "array", "items": { "$ref": "#/$defs/concept" } },
    "explained_statistics": { "type": "array", "items": { "$ref": "#/$defs/statistic" } },
    "opaque_elements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "trader_judgment_required": { "type": "string", "minLength": 1 },
    "automation_limit": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "evidence_references": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "policy_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "concept": {
      "type": "object", "additionalProperties": false,
      "required": ["concept", "plain_language_meaning"],
      "properties": {
        "concept": { "type": "string", "minLength": 1 },
        "plain_language_meaning": { "type": "string", "minLength": 1 }
      }
    },
    "statistic": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "plain_language_meaning", "calculation_reference"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "plain_language_meaning": { "type": "string", "minLength": 1 },
        "calculation_reference": { "type": "string", "minLength": 1 }
      }
    }
  }
}
