{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadygad01.github.io/aux/contracts/opportunity-identity-v1.schema.json",
  "title": "Opportunity Identity Contract",
  "description": "Schema governing canonical Opportunity Identity tracking, separating current vs previous opportunities and fresh vs repeated opportunity backtesting.",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generated_at",
    "statement",
    "current_opportunity",
    "previous_opportunity",
    "backtest_metrics"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generator": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "statement": { "type": "string" },
    "current_opportunity": {
      "type": ["object", "null"],
      "properties": {
        "opportunity_id": { "type": "string" },
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "last_updated_at": { "type": "string", "format": "date-time" },
        "creation_conditions": { "type": "array", "items": { "type": "string" } },
        "verdict": { "type": "string" },
        "setup_quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_setup_quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "execution_readiness": { "type": "object" },
        "current_state": { "type": "string" },
        "outcome": { "type": "string" },
        "archive_status": { "type": "string" },
        "is_fresh": { "type": "boolean" }
      }
    },
    "previous_opportunity": {
      "type": ["object", "null"],
      "properties": {
        "opportunity_id": { "type": "string" },
        "symbol": { "type": "string" },
        "timeframe": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "last_updated_at": { "type": "string", "format": "date-time" },
        "creation_conditions": { "type": "array", "items": { "type": "string" } },
        "verdict": { "type": "string" },
        "setup_quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max_setup_quality_score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "execution_readiness": { "type": "object" },
        "current_state": { "type": "string" },
        "outcome": { "type": "string" },
        "archive_status": { "type": "string" },
        "is_fresh": { "type": "boolean" }
      }
    },
    "backtest_metrics": { "type": "object" }
  },
  "additionalProperties": true
}
