{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shadygad01.github.io/aux/contracts/signal-prediction-v1.schema.json",
  "title": "Signal Prediction Contract",
  "description": "Schema governing Signal Prediction forecasting next expected trading opportunity window based on backtest session statistics.",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "generated_at",
    "statement",
    "signal_prediction"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "generator": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "statement": { "type": "string" },
    "signal_prediction": {
      "type": "object",
      "required": [
        "symbol",
        "current_price",
        "next_window_start",
        "next_window_end",
        "probability_next_2h_pct",
        "estimated_minutes_remaining",
        "primary_session_trigger",
        "historical_backtest_confidence_pct",
        "evaluation_time"
      ],
      "properties": {
        "symbol": { "type": "string" },
        "current_price": { "type": "number" },
        "next_window_start": { "type": "string", "format": "date-time" },
        "next_window_end": { "type": "string", "format": "date-time" },
        "probability_next_2h_pct": { "type": "number" },
        "estimated_minutes_remaining": { "type": "integer" },
        "primary_session_trigger": { "type": "string" },
        "historical_backtest_confidence_pct": { "type": "number" },
        "evaluation_time": { "type": "string", "format": "date-time" }
      }
    }
  },
  "additionalProperties": true
}
