{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-brain/knowledge-object-v1.schema.json",
  "title": "Gold Brain Knowledge Object 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_id", "revision", "title", "category", "description",
    "source_ids", "reliability", "confidence", "historical_validation",
    "last_review", "review_interval_seconds", "status",
    "supporting_evidence", "contradicting_evidence"
  ],
  "properties": {
    "knowledge_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reliability": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "historical_validation": {"type": "string", "minLength": 1},
    "last_review": {"type": "string", "format": "date-time"},
    "review_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
    "status": {
      "enum": ["OBSERVATION", "HYPOTHESIS", "VALIDATED", "INSTITUTIONAL_RULE", "DEPRECATED"]
    },
    "supporting_evidence": {
      "type": "array", "minItems": 1, "items": {"type": "string"}
    },
    "contradicting_evidence": {"type": "array", "items": {"type": "string"}}
  }
}
