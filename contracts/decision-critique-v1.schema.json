{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-brain/decision-critique-v1.schema.json",
  "title": "Decision Critique 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "critique_id", "decision_id", "decision_version", "stage", "outcome",
    "assessment", "challenged_at", "critic_policy_version"
  ],
  "properties": {
    "critique_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "decision_version": { "type": "integer", "minimum": 1 },
    "stage": { "enum": ["PRE_PUBLICATION", "OUTCOME_REVIEW"] },
    "outcome": { "enum": ["PENDING", "WINNING", "LOSING", "FALSE_POSITIVE", "REJECTED_WOULD_WIN"] },
    "challenged_at": { "type": "string", "format": "date-time" },
    "critic_policy_version": { "type": "string", "minLength": 1 },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": [
        "ignored_evidence", "overweighted_evidence", "underweighted_evidence",
        "uncertainty_assessment", "conflicting_evidence", "alternative_reasoning_path",
        "evidence_references"
      ],
      "properties": {
        "ignored_evidence": { "type": "string", "minLength": 1 },
        "overweighted_evidence": { "type": "string", "minLength": 1 },
        "underweighted_evidence": { "type": "string", "minLength": 1 },
        "uncertainty_assessment": { "type": "string", "minLength": 1 },
        "conflicting_evidence": { "type": "string", "minLength": 1 },
        "alternative_reasoning_path": { "type": "string", "minLength": 1 },
        "evidence_references": {
          "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
