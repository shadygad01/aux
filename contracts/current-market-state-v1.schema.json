{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gold-brain/current-market-state-v1.schema.json",
  "title": "Current Market State 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state_id", "symbol", "captured_at", "time_to_live_seconds", "regime", "macro_state",
    "biases", "volatility_state", "liquidity_state", "momentum_state", "news_state",
    "confidence", "uncertainty", "evidence_references", "source", "policy_version"
  ],
  "properties": {
    "state_id": { "type": "string", "pattern": "^STATE-[0-9a-f]{20}$" },
    "symbol": { "type": "string", "minLength": 1 },
    "captured_at": { "type": "string", "format": "date-time" },
    "time_to_live_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "regime": { "$ref": "market-regime-v1.schema.json" },
    "macro_state": { "type": "string", "minLength": 1 },
    "biases": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "volatility_state": { "type": "string", "minLength": 1 },
    "liquidity_state": { "type": "string", "minLength": 1 },
    "momentum_state": { "type": "string", "minLength": 1 },
    "news_state": { "type": "string", "minLength": 1 },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "uncertainty": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidence_references": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }
    },
    "source": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 }
  }
}
